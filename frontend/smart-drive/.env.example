# Copie este arquivo para .env.local e ajuste se necessário.

# API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Environment
NEXT_PUBLIC_ENV=development

# Dev: viagem assinada ao subir o app (casa com TRIP_ID do tools/telemetry-feeder).
# Sem isto, o dashboard mostra o estado vazio. Não definir em produção.
# NEXT_PUBLIC_DEV_TRIP_ID=dev-session

# Dev: identidade enviada como header x-user-id (casa com o TempUserGuard do
# backend) enquanto não existe login JWT (Pedro). Use o id de um User existente
# no banco para que GET /api/vehicles retorne seus veículos. Não definir em produção.
# NEXT_PUBLIC_DEV_USER_ID=user-dev-001
